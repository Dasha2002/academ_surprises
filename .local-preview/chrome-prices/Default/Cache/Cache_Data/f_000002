  .asny-v2 .asny-price-list { padding: 4px 22px; }
  .asny-v2 .asny-business { padding-top: 0; }
  .asny-v2 .asny-business-top { grid-template-columns: 1fr; padding: 28px; }
  .asny-v2 .asny-business-art { max-width: 450px; margin-inline: auto; }
  .asny-v2 .asny-business-art img { aspect-ratio: 1.6; }
  .asny-v2 .asny-business-benefits { grid-template-columns: 1fr; gap: 14px; }
  .asny-v2 .asny-business-benefits article { padding: 23px; }
  .asny-v2 .asny-gallery-business { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  .asny-v2 .asny-gallery-business figure > a { aspect-ratio: 1; }
  .asny-v2 .asny-gallery-business figcaption { font-size: 11px; }
  .asny-v2 .asny-v2-cta { padding-top: 0; }
  .asny-v2 .asny-v2-last-two { padding-top: 65px; padding-bottom: 25px; }
  .asny-v2 .asny-v2-ornament { width: min(var(--ornament-size), 19vw); opacity: .4; transform: rotate(var(--ornament-turn)); will-change: auto; }
  .asny-v2 .asny-v2-ornament:nth-of-type(n+5) { display: none; }
