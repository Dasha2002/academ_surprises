body.asny-page .asny-header a{font-family:inherit}.asny-header-nav>a{font-weight:600}

/* A consistent supporting type scale in the hero. */
.asny-v2 .asny-hero .asny-v2-kicker,
.asny-v2 .asny-hero .asny-hero-term,
.asny-v2 .asny-hero .asny-benefits li { font-size: 16px; line-height: 1.5; }
.asny-v2 .asny-hero .asny-v2-kicker { letter-spacing: .12em; }
.asny-v2 .asny-hero .asny-intro { font-size: 20px; line-height: 1.6; max-width: 640px; }

/* Match the ribbon red with warm white navigation. */
body.asny-page-v2 .asny-header { background: #b42c3c; color: #fffaf2; border-bottom: 1px solid #ffffff25; font-family: var(--wp--preset--font-family--sf-pro-display, "SF Pro Display"), Arial, sans-serif; }
.asny-page-v2 .asny-header-inner { max-width: 1120px; min-height: 88px; gap: 28px; }
.asny-page-v2 .asny-header-brand :is(.preview-brand, .asny-header-wordmark) { color: #fffaf2; font-family: inherit; }
.asny-page-v2 .asny-header-wordmark span,
.asny-page-v2 .asny-header-contact span { color: #f4d8d8; font-family: inherit; }
.asny-page-v2 .asny-header-contact a { color: #fffaf2; }
.asny-page-v2 .asny-header-nav { font-size: 16px; gap: 24px; }
.asny-page-v2 .asny-header-nav .asny-header-season { color: #fffaf2; background: #ffffff18; border-color: #ffffff65; }
.asny-page-v2 .asny-header-catalog-panel { color: #203b32; }
.asny-page-v2 .asny-header :is(a, summary, button):focus-visible { outline-color: #fffaf2; }
.asny-page-v2 .asny-header-catalog-panel a:focus-visible { outline-color: #b42c3c; }
.asny-page-v2 .asny-menu-toggle:not([hidden]) { background: #ffffff12; border-color: #ffffff65; color: #fffaf2; font-family: inherit; }
.asny-page-v2 .asny-header .asny-header-mobile-phone { color: #fffaf2; border-color: #ffffff40; }
@media (hover: hover) {
  .asny-page-v2 .asny-header-nav > a:hover,
  .asny-page-v2 .asny-header summary:hover { color: #fffaf2; text-decoration: underline; text-underline-offset: 5px; }
}
@media (max-width: 1199px) {
  .asny-page-v2 .asny-header-inner { gap: 0 16px; }
  .asny-page-v2 .asny-header-nav { gap: 0; }
}
@media (max-width: 767px) {
  .asny-v2 .asny-hero .asny-intro { font-size: 18px; }
  .asny-page-v2 .asny-header-inner { min-height: 74px; }
  .asny-page-v2 .asny-header-brand { min-width: 0; flex: 1 1 0; max-width: 210px; }
  .asny-page-v2 .asny-header-brand .custom-logo-link { max-width: 100%; }
  .asny-page-v2 .asny-header-catalog-panel ul { grid-template-columns: 1fr; }
}

/* Match reference typography and underline the current destination. */
@font-face { font-family: 'ASNY Manrope'; src: url('../fonts/manrope/Manrope-VariableFont_wght.woff2') format('woff2'); font-weight: 200 800; font-display: swap; }
body.asny-page-v2 .asny-header { --header-bg: #b42c3c; --header-ink: #fffaf2; --header-muted: #f4d8d8; --header-active: #fffaf2; --header-line: #ffffff55; background: var(--header-bg); color: var(--header-ink); font-family: 'ASNY Manrope', Arial, sans-serif; }
body.asny-page-v2 .asny-header[data-theme="beige"] { --header-bg: #fffaf2; --header-ink: #204735; --header-muted: #596451; --header-active: #b42c3c; --header-line: #cad0c1; }
.asny-page-v2 .asny-header { --header-font-size: 18px; }
.asny-page-v2 .asny-header-nav,
.asny-page-v2 .asny-header-nav > a,
.asny-page-v2 .asny-header summary,
.asny-page-v2 .asny-header-catalog-panel a,
.asny-page-v2 .asny-menu-toggle:not([hidden]) { font-size: var(--header-font-size); }
.asny-page-v2 .asny-header-nav { gap: 28px; }
.asny-page-v2 .asny-header-nav .asny-header-season { padding: 10px 0 7px; border: 0; border-bottom: 2px solid var(--header-active); border-radius: 0; background: transparent; color: var(--header-active); font-weight: 750; }
.asny-page-v2 .asny-header-catalog > summary::after { content: ''; display: block; flex: none; width: 6px; height: 6px; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: rotate(45deg); margin-top: -4px; }
.asny-page-v2 .asny-header-catalog[open] > summary::after { transform: rotate(225deg); margin-top: 4px; }
.asny-page-v2 .asny-header-contact a { font-size: 22.667px; color: var(--header-ink); }
.asny-page-v2 .asny-header-contact span { font-size: 13.333px; color: var(--header-muted); }
.asny-page-v2 .asny-header-brand :is(.preview-brand, .asny-header-wordmark) { color: var(--header-ink); }
.asny-page-v2 .asny-header-wordmark span { color: var(--header-muted); }
.asny-page-v2 .asny-menu-toggle:not([hidden]) { color: var(--header-ink); border-color: var(--header-line); background: transparent; }
.asny-page-v2 .asny-header .asny-header-mobile-phone { color: var(--header-ink); border-color: var(--header-line); }
.asny-page-v2 .asny-header :is(a, summary, button):focus-visible { outline-color: var(--header-active); }
.asny-page-v2 .asny-header-catalog-panel a:focus-visible { outline-color: #b42c3c; }
.asny-page-v2 .asny-header-catalog-panel { width: min(760px, calc(100vw - 80px)); max-height: calc(100dvh - 140px); overflow-y: auto; }
@media (hover: hover) {
  .asny-page-v2 .asny-header-nav > a:hover,
  .asny-page-v2 .asny-header summary:hover { color: var(--header-ink); }
}
@media (max-width: 1200px) { .asny-page-v2 .asny-header-contact a { font-size: 20px; } }
@media (max-width: 1199px) {
  .asny-page-v2 .asny-header-nav { gap: 0; }
  .asny-page-v2 .asny-header-catalog-panel { width: 100%; max-height: none; }
}
@media (max-width: 1100px) { .asny-page-v2 .asny-header { --header-font-size: 17px; } }
@media (max-width: 900px) { .asny-page-v2 .asny-header { --header-font-size: 16px; } }
@media (max-width: 380px) { .asny-page-v2 .asny-header { --header-font-size: 15px; } }

.asny-v2 .asny-hero-copy > .asny-button { font-size: 16px; }

.asny-v2 .asny-hero .asny-hero-term { font-size: 20px; }
@media (max-width: 767px) {
  .asny-v2 .asny-hero .asny-hero-term { font-size: 18px; }
}

/* Gift selection: readable copy and a clear calculation action. */
.asny-v2 { --v2-accent: #b42c3c; }
.asny-v2 .asny-button { background: #b42c3c; border-color: #b42c3c; color: #fffaf2; }
.asny-v2 .asny-button:hover { background: #962432; border-color: #962432; }
.asny-v2 .asny-button:active { transform: scale(.98); }
.asny-v2 :is(#asny-gifts, #asny-works) .asny-section-heading { display: block; text-align: left; }
.asny-v2 :is(#asny-gifts, #asny-works) .asny-section-heading > div { max-width: 800px; margin-inline: 0; }
.asny-v2 :is(#asny-gifts, #asny-works) .asny-section-heading h2 { font-size: clamp(32px, 3.5vw, 46px); }
.asny-v2 :is(#asny-gifts, #asny-works) .asny-section-heading > p { max-width: 65ch; margin: 20px 0 0; font-size: 20px; line-height: 1.6; color: #4d6054; }
.asny-v2 #asny-gifts .asny-product h3 { padding: 24px 24px 0; font-size: 26px; font-weight: 600; line-height: 1.25; }
.asny-v2 #asny-gifts .asny-product:nth-child(-n+2) h3 { font-size: 28px; }
.asny-v2 #asny-gifts .asny-product > p { padding: 16px 24px 0; font-size: 18px; line-height: 1.6; color: #4d6054; }
.asny-v2 #asny-gifts .asny-product > .asny-calendar-note { font-size: 15px; }
.asny-v2 #asny-gifts .asny-product-action { margin-top: auto; padding: 24px 24px 0; }
.asny-v2 #asny-gifts .asny-product-action .asny-button { width: 100%; padding-inline: 14px; font-size: 16px; white-space: nowrap; }
.asny-v2 #asny-works .asny-gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; }
.asny-v2 #asny-works .asny-gallery figure { display: flex; flex-direction: column; padding: 10px; }
.asny-v2 #asny-works .asny-gallery figure > a { aspect-ratio: 4 / 3; }
.asny-v2 #asny-works .asny-gallery figcaption { display: flex; flex: 1; flex-direction: column; align-items: flex-start; gap: 14px; margin: 0; padding: 22px 14px 14px; text-align: left; }
.asny-v2 #asny-works figcaption h3 { font-size: 24px; font-weight: 600; line-height: 1.3; }
.asny-v2 #asny-works figcaption p { font-size: 18px; line-height: 1.6; color: #4d6054; }
.asny-v2 #asny-works figcaption .asny-button { margin-top: auto; font-size: 16px; white-space: nowrap; }
@media (max-width: 767px) {
  .asny-v2 #asny-gifts .asny-catalog,
  .asny-v2 #asny-works .asny-gallery { grid-template-columns: minmax(0, 1fr); gap: 24px; }
  .asny-v2 #asny-gifts .asny-product { grid-column: auto; max-width: none; }
  .asny-v2 #asny-gifts .asny-product h3,
  .asny-v2 #asny-gifts .asny-product:nth-child(-n+2) h3 { font-size: 24px; padding-inline: 20px; }
  .asny-v2 #asny-gifts .asny-product > p { padding-inline: 20px; }
  .asny-v2 #asny-gifts .asny-product-action { padding-inline: 20px; }
  .asny-v2 :is(#asny-gifts, #asny-works) .asny-section-heading { padding-inline: 0; }
  .asny-v2 :is(#asny-gifts, #asny-works) .asny-section-heading > p { font-size: 18px; }
  .asny-v2 #asny-works figcaption .asny-button { width: 100%; padding-inline: 12px; }
}

.asny-v2 #asny-gifts { padding-bottom: 28px; }
@media (max-width: 767px) {
  .asny-v2 #asny-gifts { padding-bottom: 12px; }
}

/* Prices: five individual product rows; decorations sit behind the content. */
.asny-v2 #asny-prices { position: relative; isolation: isolate; overflow: hidden; padding-block: 88px 64px; background: #9e1b2c; }
.asny-v2 #asny-prices > .asny-container { position: relative; z-index: 1; max-width: 1000px; }
.asny-v2 #asny-prices .asny-section-heading { display: block; max-width: 760px; margin: 0 auto 40px; padding: 0; text-align: center; }
.asny-v2 #asny-prices .asny-section-heading h2 { font-size: clamp(32px, 3.5vw, 44px); }
.asny-v2 #asny-prices .asny-section-heading > p { margin: 20px auto 0; max-width: 580px; font-size: 18px; line-height: 1.6; color: #f8e2df; }
.asny-v2 #asny-prices .asny-price-list { display: grid; gap: 14px; padding: 0; border: 0; border-radius: 0; background: transparent; box-shadow: none; }
.asny-v2 #asny-prices .asny-price-row { display: grid; grid-template-columns: 104px minmax(0, 1fr) auto; align-items: center; gap: 24px; padding: 16px 24px 16px 16px; border: 1px solid #f3d9d2; border-radius: 12px; background: #fffaf2; color: #203b32; }
.asny-v2 #asny-prices .asny-price-row:nth-child(even) { background: #f0f1e7; border-color: #dfe3d4; }
.asny-v2 #asny-prices .asny-price-thumb { width: 104px; height: 112px; overflow: hidden; border-radius: 8px; }
.asny-v2 #asny-prices .asny-price-thumb img { display: block; width: 100%; height: 100%; object-fit: cover; border-radius: inherit; }
.asny-v2 #asny-prices .asny-price-copy h3 { font-size: 23px; line-height: 1.3; color: #203b32; font-weight: 600; }
.asny-v2 #asny-prices .asny-price-copy p { margin-top: 12px; font-size: 16px; line-height: 1.5; color: #4d6054; }
.asny-v2 #asny-prices .asny-price-copy p span { display: block; margin-bottom: 3px; font-size: 13px; color: #586858; }
.asny-v2 #asny-prices .asny-price-row .asny-button { grid-column: auto; grid-row: auto; white-space: nowrap; font-size: 16px; padding-inline: 20px; }
.asny-v2 #asny-prices > .asny-container > .asny-note { margin: 28px auto 0; max-width: 660px; font-size: 15px; line-height: 1.6; }
.asny-prices-garlands { position: absolute; inset: 0 0 auto; height: 52%; pointer-events: none; z-index: 0; }
.asny-prices-garlands img { position: absolute; top: -24px; left: -35px; height: 100%; width: min(27vw, 360px); object-fit: contain; object-position: top left; }
.asny-prices-garlands img + img { left: auto; right: -35px; transform: scaleX(-1); }
@media (max-width: 1100px) {
  .asny-prices-garlands img { left: -70px; width: 230px; }
  .asny-prices-garlands img + img { right: -70px; }
}
@media (max-width: 767px) {
  .asny-v2 #asny-prices { padding-block: 64px 44px; }
  .asny-v2 #asny-prices > .asny-container { width: calc(100% - 40px); }
  .asny-v2 #asny-prices .asny-section-heading { margin-bottom: 28px; }
  .asny-v2 #asny-prices .asny-section-heading > p { font-size: 17px; }
  .asny-v2 #asny-prices .asny-price-row { grid-template-columns: 76px minmax(0, 1fr); gap: 16px; padding: 16px; }
  .asny-v2 #asny-prices .asny-price-thumb { width: 76px; height: 94px; }
  .asny-v2 #asny-prices .asny-price-copy h3 { font-size: 20px; }
  .asny-v2 #asny-prices .asny-price-copy p { margin-top: 8px; font-size: 15px; }
  .asny-v2 #asny-prices .asny-price-row .asny-button { grid-column: 1 / -1; justify-self: stretch; }
  .asny-prices-garlands img { width: 140px; left: -78px; }
  .asny-prices-garlands img + img { right: -78px; }
}
