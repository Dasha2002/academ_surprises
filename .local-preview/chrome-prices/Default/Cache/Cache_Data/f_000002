  .asny-v2 .asny-product h3 { padding-inline: 18px; font-size: 19px; }
  .asny-v2 .asny-product > p { padding-inline: 18px; }
  .asny-v2 .asny-product > .asny-text-link { margin-inline: 18px; }
  .asny-v2 .asny-gallery { gap: 15px; }
  .asny-v2 .asny-price-row { gap: 15px; }
}
@media (max-width: 767px) {
