  .asny-v2 h1 { font-size: clamp(38px, 7vw, 54px); }
  .asny-v2 .asny-hero .asny-v2-backdrop { background-image: url('../images/new-year/v2/hero-phone.jpg'); background-size: cover; }
  .asny-v2 .asny-hero-copy { max-width: 560px; }
  .asny-v2 .asny-intro { font-size: 14px; max-width: 480px; }
  .asny-v2 .asny-benefits { gap: 10px; margin-block: 24px; padding-top: 20px; }
  .asny-v2 .asny-benefits li { font-size: 11px; padding-inline: 5px; }
  .asny-v2 .asny-hero .asny-note { font-size: 11px; }
  .asny-v2 .asny-section { padding-block: 55px; }
  .asny-v2 .asny-section-heading { margin-bottom: 28px; }
  .asny-v2 .asny-section-heading > p { font-size: 14px; }
  .asny-v2 .asny-catalog { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .asny-v2 .asny-product, .asny-v2 .asny-product:nth-child(-n+2) { grid-column: auto; }
