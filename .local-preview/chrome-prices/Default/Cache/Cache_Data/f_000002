  .asny-v2 .asny-product-image, .asny-v2 .asny-product:nth-child(-n+2) .asny-product-image { aspect-ratio: 1.2; }
  .asny-v2 .asny-product:nth-child(-n+2) h3 { font-size: 21px; }
  .asny-v2 .asny-product:last-child .asny-product-image { aspect-ratio: 1.6; }
